{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReCoAlign governed experiment result",
  "type": "object",
  "required": [
    "schema_version", "run_id", "experiment_id", "hypothesis", "model", "dataset", "seed",
    "metrics", "confidence_interval", "statistical_test", "decision", "timestamp", "integrity",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP[0-9]{3}$"},
    "hypothesis": {"type": "string", "pattern": "^H[0-9]{3}$"},
    "model": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "seed": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      ]
    },
    "metrics": {"type": "object"},
    "confidence_interval": {"type": ["object", "null"]},
    "statistical_test": {"type": ["object", "null"]},
    "decision": {"enum": ["GO", "NO-GO", "INCONCLUSIVE"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "integrity": {"type": "object"},
    "status": {"enum": ["dry-run", "complete", "failed"]}
  },
  "additionalProperties": false
}
