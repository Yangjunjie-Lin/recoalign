{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReCoAlign Phase-2.1 VLM model configuration",
  "type": "object",
  "required": [
    "schema_version", "name", "adapter", "scientific_evidence", "model", "generation",
    "runtime", "prompt_protocol", "compatibility"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"enum": ["reference", "llava_1_5_7b", "llava_next", "qwen_vl", "internvl"]},
    "adapter": {"enum": ["reference", "llava_1_5_7b", "llava_next", "qwen_vl", "internvl"]},
    "scientific_evidence": {"type": "boolean"},
    "checkpoint_manifest": {"type": ["string", "null"]},
    "prompt_protocol": {"type": "string", "minLength": 1},
    "model": {"type": "object"},
    "generation": {
      "type": "object",
      "required": ["temperature", "do_sample", "max_new_tokens"],
      "properties": {
        "temperature": {"const": 0.0},
        "do_sample": {"const": false},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "num_beams": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["lazy_load", "batch_size", "cache_enabled", "cache_dir"],
      "properties": {
        "lazy_load": {"const": true},
        "batch_size": {"type": "integer", "minimum": 1},
        "cache_enabled": {"type": "boolean"},
        "cache_dir": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["EXP001", "EXP002", "EXP003"]}
    }
  },
  "additionalProperties": false
}
