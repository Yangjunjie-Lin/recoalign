{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReCoAlign experiment registry",
  "type": "object",
  "required": ["schema_version", "defaults", "experiments"],
  "properties": {
    "schema_version": {"const": 1},
    "defaults": {
      "type": "object",
      "required": [
        "confidence_level", "seeds", "critical_experiment_seeds",
        "significance_level", "bootstrap_samples"
      ],
      "properties": {
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "seeds": {"type": "integer", "minimum": 3},
        "critical_experiment_seeds": {"type": "integer", "minimum": 5},
        "significance_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_samples": {"type": "integer", "minimum": 100}
      },
      "additionalProperties": false
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "experiment_id", "hypothesis_id", "title", "objective", "conditions", "input_conditions",
          "dataset", "model", "metrics", "expected_result", "decision_rule", "protocol",
          "config", "status"
        ],
        "properties": {
          "experiment_id": {"type": "string", "pattern": "^EXP[0-9]{3}$"},
          "hypothesis_id": {"type": "string", "pattern": "^H[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "conditions": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "input_conditions": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "dataset": {
            "type": "object",
            "required": ["name", "version", "manifest", "split"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "manifest": {"type": "string", "minLength": 1},
              "split": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "model": {
            "type": "object",
            "required": [
              "state", "configured_backend", "training_allowed", "evidence_role",
              "scientific_decision_allowed"
            ],
            "properties": {
              "state": {"const": "frozen"},
              "configured_backend": {"type": "string", "minLength": 1},
              "allowed_backends": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "scientific_backends": {
                "type": "array", "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "training_allowed": {"const": false},
              "evidence_role": {
                "enum": ["infrastructure_validation", "scientific_evidence"]
              },
              "scientific_decision_allowed": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "required": ["primary", "secondary", "rationale"],
            "properties": {
              "primary": {"type": "string", "minLength": 1},
              "secondary": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "rationale": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "expected_result": {"type": "string", "minLength": 1},
          "decision_rule": {
            "type": "object",
            "required": [
              "alternative", "criteria", "statistical_significance",
              "confidence_interval_excludes_zero", "robustness"
            ],
            "properties": {
              "alternative": {"enum": ["greater", "less", "two-sided"]},
              "criteria": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["metric_path", "minimum_gain"],
                  "properties": {
                    "metric_path": {"type": "string", "minLength": 1},
                    "minimum_gain": {"type": "number"}
                  },
                  "additionalProperties": false
                }
              },
              "statistical_significance": {
                "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1
              },
              "confidence_interval_excludes_zero": {"type": "boolean"},
              "robustness": {
                "type": "object",
                "required": ["minimum_seeds", "minimum_positive_seed_fraction"],
                "properties": {
                  "minimum_seeds": {"type": "integer", "minimum": 3},
                  "minimum_positive_seed_fraction": {
                    "type": "number", "minimum": 0, "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              "required_manifest_assertions": {
                "type": "object",
                "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
              }
            },
            "additionalProperties": false
          },
          "protocol": {"type": "string", "minLength": 1},
          "config": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "registered", "running", "complete", "cancelled"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
