{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReCoAlign hypothesis registry",
  "type": "object",
  "required": ["schema_version", "hypotheses"],
  "properties": {
    "schema_version": {"const": 1},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "description", "motivation", "prediction",
          "falsification", "required_experiment", "status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^H[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "motivation": {"type": "string", "minLength": 1},
          "prediction": {"type": "string", "minLength": 1},
          "falsification": {"type": "string", "minLength": 1},
          "required_experiment": {"type": "string", "pattern": "^EXP[0-9]{3}$"},
          "status": {"enum": ["proposed", "testing", "supported", "falsified", "retired"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
